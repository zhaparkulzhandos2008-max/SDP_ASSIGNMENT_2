@startuml
interface Character
interface Weapon
interface Enemy
abstract class CharacterCreator
class FantasyCharacterCreator
class CyberpunkCharacterCreator
class HorrorCharacterCreator
CharacterCreator <|-- FantasyCharacterCreator
CharacterCreator <|-- CyberpunkCharacterCreator
CharacterCreator <|-- HorrorCharacterCreator
CharacterCreator ..> Character : Factory Method
interface GameFactory
class FantasyFactory
class CyberpunkFactory
class HorrorFactory
class SciFiFactory
GameFactory <|.. FantasyFactory
GameFactory <|.. CyberpunkFactory
GameFactory <|.. HorrorFactory
GameFactory <|.. SciFiFactory
class GameApplication
GameApplication --> GameFactory : Abstract Factory
GameApplication --> Character
GameApplication --> Weapon
GameApplication --> Enemy
class Main
Main --> GameApplication
Main --> GameFactory
@enduml
